FIREBASE_API_KEY=
FIREBASE_SERVICE_ACCOUNT=
VITE_CARTO_API_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
# Chinguisoft SMS gateway (phone OTP). Used only by Cloud Functions, never the
# browser. Set them as Firebase secrets:
#   firebase functions:secrets:set CHINGUISOFT_API_TOKEN
#   firebase functions:secrets:set CHINGUISOFT_CAMPAIGN_KEY
# For the local emulator, put them in functions/.secret.local instead.
CHINGUISOFT_API_TOKEN=
CHINGUISOFT_CAMPAIGN_KEY=
