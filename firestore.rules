rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function verifiedUser() {
      return isSignedIn()
        && (
          ('phone_number' in request.auth.token
            && request.auth.token.phone_number is string
            && request.auth.token.phone_number.size() > 0
            && request.auth.token.phone_number.size() <= 32)
          || ('email_verified' in request.auth.token
            && request.auth.token.email_verified == true)
        );
    }

    function isAdmin() {
      return isSignedIn()
        && (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          || ('email' in request.auth.token
            && request.auth.token.email == 'davionbase@gmail.com'
            && 'email_verified' in request.auth.token
            && request.auth.token.email_verified == true)
        );
    }

    function counterPath(name) {
      return /databases/$(database)/documents/$(name)/$(request.auth.uid);
    }

    function rolePath() {
      return /databases/$(database)/documents/roles/$(request.auth.uid);
    }

    function myRole() {
      return get(rolePath()).data;
    }

    function isOfficial() {
      return verifiedUser()
        && exists(rolePath())
        && myRole().approved == true;
    }

    match /test/{docId} {
      allow get: if isValidId(docId);
      allow list, write: if false;
    }

    match /admins/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list, write: if false;
    }

    function isValidRole(data, userId) {
      return data.keys().hasAll(['uid', 'role', 'org', 'name', 'approved', 'approvedBy', 'approvedAt'])
        && data.keys().hasOnly(['uid', 'role', 'org', 'name', 'approved', 'approvedBy', 'approvedAt'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 && data.uid == userId
        && data.role is string && data.role.size() <= 20 && data.role == 'official'
        && data.org is string && data.org.size() > 0 && data.org.size() <= 100
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.approved is bool
        && data.approvedBy is string && data.approvedBy.size() > 0 && data.approvedBy.size() <= 128 && data.approvedBy == request.auth.uid
        && data.approvedAt is timestamp;
    }

    match /roles/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if isSignedIn()
        && isValidId(userId)
        && isValidRole(incoming(), userId)
        && incoming().approvedAt == request.time
        && isAdmin();

      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidRole(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['org', 'name', 'approved', 'approvedBy', 'approvedAt'])
        && isAdmin();

      allow delete: if isSignedIn() && isValidId(userId) && isAdmin();
    }

    function isValidRoleRequest(data, userId) {
      return data.keys().hasAll(['uid', 'org', 'name', 'title', 'proof', 'status', 'createdAt'])
        && data.keys().hasOnly(['uid', 'org', 'name', 'title', 'proof', 'status', 'createdAt', 'reviewedBy', 'reviewedAt'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 && data.uid == userId
        && data.org is string && data.org.size() > 0 && data.org.size() <= 100
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.title is string && data.title.size() <= 100
        && data.proof is string && data.proof.size() > 0 && data.proof.size() <= 500
        && data.status is string && data.status.size() <= 20 && data.status in ['pending', 'approved', 'rejected']
        && data.createdAt is timestamp;
    }

    match /roleRequests/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      allow create: if verifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidRoleRequest(incoming(), userId)
        && incoming().keys().hasOnly(['uid', 'org', 'name', 'title', 'proof', 'status', 'createdAt'])
        && incoming().status == 'pending'
        && incoming().createdAt == request.time;

      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidRoleRequest(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && (
          (isAdmin()
            && incoming().status in ['approved', 'rejected']
            && incoming().reviewedBy is string
            && incoming().reviewedBy.size() > 0
            && incoming().reviewedBy.size() <= 128
            && incoming().reviewedBy == request.auth.uid
            && incoming().reviewedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt']))
        );

      allow delete: if isSignedIn() && isValidId(userId) && isAdmin();
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll(['uid', 'org', 'area', 'areaId', 'lat', 'lng', 'geohash', 'text', 'createdAt', 'expiresAt'])
        && data.keys().hasOnly(['uid', 'org', 'area', 'areaId', 'lat', 'lng', 'geohash', 'text', 'createdAt', 'expiresAt'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.org is string && data.org.size() > 0 && data.org.size() <= 100
        && data.area is string && data.area.size() > 0 && data.area.size() <= 100
        && data.areaId is string && data.areaId.size() > 0 && data.areaId.size() <= 100
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && data.geohash is string && data.geohash.size() > 0 && data.geohash.size() <= 20
        && data.text is string && data.text.size() > 0 && data.text.size() <= 500
        && data.createdAt == request.time
        && data.expiresAt is timestamp
        && data.expiresAt > request.time
        && data.expiresAt < request.time + duration.value(49, 'h');
    }

    match /announcements/{announcementId} {
      // Official outage notices are public map data readable by all visitors.
      allow get, list: if true;

      allow create: if isSignedIn()
        && isValidId(announcementId)
        && isValidAnnouncement(incoming())
        && (
          (isOfficial() && incoming().org == myRole().org)
          || isAdmin()
        );

      allow update: if false;
      allow delete: if isSignedIn()
        && isValidId(announcementId)
        && (isAdmin() || (isOfficial() && resource.data.uid == request.auth.uid));
    }

    function isValidSourceDraft(data) {
      return data.keys().hasAll(['source', 'org', 'text', 'areaId', 'status', 'fetchedAt'])
        && data.keys().hasOnly(['source', 'org', 'url', 'text', 'areaId', 'status', 'fetchedAt', 'reviewedBy', 'reviewedAt'])
        && data.source is string && data.source.size() > 0 && data.source.size() <= 100
        && data.org is string && data.org.size() > 0 && data.org.size() <= 100
        && data.text is string && data.text.size() > 0 && data.text.size() <= 500
        && data.areaId is string && data.areaId.size() > 0 && data.areaId.size() <= 100
        && data.status is string && data.status.size() <= 20 && data.status in ['pending', 'published', 'discarded']
        && data.fetchedAt is timestamp;
    }

    match /sourceDrafts/{draftId} {
      allow get: if isValidId(draftId) && isAdmin();
      allow list: if isAdmin();
      allow create: if false;

      allow update: if isSignedIn()
        && isValidId(draftId)
        && isValidSourceDraft(incoming())
        && isAdmin()
        && incoming().status in ['published', 'discarded']
        && incoming().reviewedBy is string
        && incoming().reviewedBy.size() > 0
        && incoming().reviewedBy.size() <= 128
        && incoming().reviewedBy == request.auth.uid
        && incoming().reviewedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt']);

      allow delete: if isSignedIn() && isValidId(draftId) && isAdmin();
    }

    function statsPath() { return counterPath('userStats'); }
    function firstEverReport() { return !exists(statsPath()); }
    function statsBefore() { return get(statsPath()).data; }
    function statsAfter() { return getAfter(statsPath()).data; }

    function cooldownElapsed() {
      return firstEverReport()
        || request.time > statsBefore().lastReportAt + duration.value(60, 's');
    }

    function dayWindowExpired() {
      return firstEverReport()
        || request.time > statsBefore().dayStartedAt + duration.value(1, 'd');
    }

    function underDailyCap() {
      return dayWindowExpired() || statsBefore().dailyCount < 20;
    }

    function counterBumped() {
      return statsAfter().uid == request.auth.uid
        && statsAfter().lastReportAt == request.time;
    }

    function votePath(reportId) {
      return /databases/$(database)/documents/reports/$(reportId)/votes/$(request.auth.uid);
    }

    function isValidReport(data) {
      return data.keys().hasAll(['uid', 'type', 'lat', 'lng', 'geohash', 'createdAt', 'stillOutCount', 'restoredCount'])
        && data.keys().hasOnly([
          'uid', 'type', 'lat', 'lng', 'geohash', 'createdAt',
          'stillOutCount', 'restoredCount', 'details',
          'reportMode', 'outageStartedAt', 'durationHours', 'cause'
        ])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.type is string && data.type.size() <= 20 && data.type in ['power', 'water', 'fuel']
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && data.geohash is string && data.geohash.size() > 0 && data.geohash.size() <= 20
        && data.createdAt is timestamp
        && data.stillOutCount is int && data.stillOutCount >= 0
        && data.restoredCount is int && data.restoredCount >= 0
        && (!('details' in data) || (data.details is string && data.details.size() <= 280))
        && (!('reportMode' in data) || (data.reportMode is string && data.reportMode.size() <= 20 && data.reportMode in ['current', 'past']))
        && (!('outageStartedAt' in data) || (data.outageStartedAt is string && data.outageStartedAt.size() <= 40))
        && (!('durationHours' in data) || (data.durationHours is number && data.durationHours >= 0 && data.durationHours <= 168))
        && (!('cause' in data) || (data.cause is string && data.cause.size() <= 20 && data.cause in ['unplanned', 'maintenance']));
    }

    match /reports/{reportId} {
      // Outage reports are public map pins readable by all visitors.
      allow get, list: if true;

      allow create: if verifiedUser()
        && isValidId(reportId)
        && isValidReport(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().stillOutCount == 0
        && incoming().restoredCount == 0
        && cooldownElapsed()
        && underDailyCap()
        && counterBumped();

      allow update: if verifiedUser()
        && isValidId(reportId)
        && isValidReport(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && !exists(votePath(reportId))
        && incoming().diff(existing()).affectedKeys().hasOnly(['stillOutCount', 'restoredCount'])
        && (
          (getAfter(votePath(reportId)).data.value == 'still_out'
            && incoming().stillOutCount == existing().stillOutCount + 1
            && incoming().restoredCount == existing().restoredCount)
          || (getAfter(votePath(reportId)).data.value == 'restored'
            && incoming().restoredCount == existing().restoredCount + 1
            && incoming().stillOutCount == existing().stillOutCount)
        );

      allow delete: if isAdmin()
        || (isSignedIn() && existing().uid == request.auth.uid)
        || (isSignedIn() && request.time > existing().createdAt + duration.value(24, 'h'));

      function isValidVote(data, voterId) {
        return data.keys().hasAll(['uid', 'value', 'createdAt'])
          && data.keys().hasOnly(['uid', 'value', 'createdAt'])
          && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 && data.uid == voterId
          && data.value is string && data.value.size() <= 20 && data.value in ['still_out', 'restored']
          && data.createdAt == request.time;
      }

      match /votes/{voterId} {
        allow get, list: if true;

        allow create: if verifiedUser()
          && isValidId(reportId)
          && isValidId(voterId)
          && request.auth.uid == voterId
          && isValidVote(incoming(), voterId)
          && exists(/databases/$(database)/documents/reports/$(reportId));

        allow update, delete: if false;
      }
    }

    function isValidUserStats(data, userId) {
      return data.keys().hasAll(['uid', 'lastReportAt', 'dailyCount', 'dayStartedAt'])
        && data.keys().hasOnly(['uid', 'lastReportAt', 'dailyCount', 'dayStartedAt'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 && data.uid == userId
        && data.lastReportAt == request.time
        && data.dailyCount is int && data.dailyCount >= 1 && data.dailyCount <= 20
        && data.dayStartedAt is timestamp;
    }

    match /userStats/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;

      allow create: if verifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserStats(incoming(), userId)
        && incoming().dailyCount == 1
        && incoming().dayStartedAt == request.time;

      allow update: if verifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserStats(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['lastReportAt', 'dailyCount', 'dayStartedAt'])
        && (
          (request.time > existing().dayStartedAt + duration.value(1, 'd')
            && incoming().dailyCount == 1
            && incoming().dayStartedAt == request.time)
          || (request.time <= existing().dayStartedAt + duration.value(1, 'd')
            && incoming().dailyCount == existing().dailyCount + 1
            && incoming().dayStartedAt == existing().dayStartedAt)
        );

      allow delete: if false;
    }

    function chatPath() { return counterPath('chatStats'); }
    function firstEverMessage() { return !exists(chatPath()); }
    function chatBefore() { return get(chatPath()).data; }
    function chatAfter() { return getAfter(chatPath()).data; }

    function chatCooldownElapsed() {
      return firstEverMessage()
        || request.time > chatBefore().lastMessageAt + duration.value(10, 's');
    }

    function chatDayExpired() {
      return firstEverMessage()
        || request.time > chatBefore().dayStartedAt + duration.value(1, 'd');
    }

    function underChatCap() {
      return chatDayExpired() || chatBefore().dailyCount < 100;
    }

    function chatCounterBumped() {
      return chatAfter().uid == request.auth.uid
        && chatAfter().lastMessageAt == request.time;
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['uid', 'text', 'lat', 'lng', 'geohash', 'createdAt'])
        && data.keys().hasOnly([
          'uid', 'text', 'lat', 'lng', 'geohash', 'createdAt',
          'scope', 'neighbourhoodId', 'neighbourhoodName', 'regionId', 'regionName'
        ])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.text is string && data.text.size() > 0 && data.text.size() <= 300
        && data.lat is number && data.lat >= -90 && data.lat <= 90
        && data.lng is number && data.lng >= -180 && data.lng <= 180
        && data.geohash is string && data.geohash.size() > 0 && data.geohash.size() <= 20
        && data.createdAt == request.time
        && (!('scope' in data) || (data.scope is string && data.scope.size() <= 20 && data.scope in ['radius', 'neighbourhood', 'region', 'global']))
        && (!('neighbourhoodId' in data) || (data.neighbourhoodId is string && data.neighbourhoodId.size() <= 80))
        && (!('neighbourhoodName' in data) || (data.neighbourhoodName is string && data.neighbourhoodName.size() <= 120))
        && (!('regionId' in data) || (data.regionId is string && data.regionId.size() <= 80))
        && (!('regionName' in data) || (data.regionName is string && data.regionName.size() <= 120));
    }

    match /messages/{messageId} {
      // Neighbourhood messages are public feed items readable by all visitors.
      allow get, list: if true;

      allow create: if verifiedUser()
        && isValidId(messageId)
        && isValidMessage(incoming())
        && chatCooldownElapsed()
        && underChatCap()
        && chatCounterBumped();

      allow update: if false;
      allow delete: if isAdmin()
        || (isSignedIn() && existing().uid == request.auth.uid)
        || (isSignedIn() && request.time > existing().createdAt + duration.value(72, 'h'));
    }

    function isValidChatStats(data, userId) {
      return data.keys().hasAll(['uid', 'lastMessageAt', 'dailyCount', 'dayStartedAt'])
        && data.keys().hasOnly(['uid', 'lastMessageAt', 'dailyCount', 'dayStartedAt'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 && data.uid == userId
        && data.lastMessageAt == request.time
        && data.dailyCount is int && data.dailyCount >= 1 && data.dailyCount <= 100
        && data.dayStartedAt is timestamp;
    }

    match /chatStats/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;

      allow create: if verifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidChatStats(incoming(), userId)
        && incoming().dailyCount == 1
        && incoming().dayStartedAt == request.time;

      allow update: if verifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidChatStats(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['lastMessageAt', 'dailyCount', 'dayStartedAt'])
        && (
          (request.time > existing().dayStartedAt + duration.value(1, 'd')
            && incoming().dailyCount == 1
            && incoming().dayStartedAt == request.time)
          || (request.time <= existing().dayStartedAt + duration.value(1, 'd')
            && incoming().dailyCount == existing().dailyCount + 1
            && incoming().dayStartedAt == existing().dayStartedAt)
        );

      allow delete: if false;
    }

    function isValidStationStatus(data, stationId) {
      return data.keys().hasAll(['stationId', 'status', 'hasGasCount', 'noGasCount', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['stationId', 'status', 'hasGasCount', 'noGasCount', 'updatedBy', 'updatedAt'])
        && data.stationId is string && data.stationId.size() > 0 && data.stationId.size() <= 128 && data.stationId == stationId
        && data.status is string && data.status.size() <= 20 && data.status in ['has_gas', 'no_gas']
        && data.hasGasCount is int && data.hasGasCount >= 0
        && data.noGasCount is int && data.noGasCount >= 0
        && data.updatedBy is string && data.updatedBy.size() > 0 && data.updatedBy.size() <= 128 && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time;
    }

    match /stationStatus/{stationId} {
      allow get, list: if true;

      allow create: if verifiedUser()
        && isValidId(stationId)
        && isValidStationStatus(incoming(), stationId)
        && (
          (incoming().status == 'has_gas' && incoming().hasGasCount == 1 && incoming().noGasCount == 0)
          || (incoming().status == 'no_gas' && incoming().noGasCount == 1 && incoming().hasGasCount == 0)
        );

      allow update: if verifiedUser()
        && isValidId(stationId)
        && isValidStationStatus(incoming(), stationId)
        && incoming().stationId == existing().stationId
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'hasGasCount', 'noGasCount', 'updatedBy', 'updatedAt'])
        && (
          (incoming().status == 'has_gas'
            && incoming().hasGasCount == existing().hasGasCount + 1
            && incoming().noGasCount == existing().noGasCount)
          || (incoming().status == 'no_gas'
            && incoming().noGasCount == existing().noGasCount + 1
            && incoming().hasGasCount == existing().hasGasCount)
        );

      allow delete: if false;
    }
  }
}
